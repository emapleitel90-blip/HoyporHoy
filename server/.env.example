# Configuración del Puerto
PORT=3001

# Base de Datos (PostgreSQL)
# Ejemplo Local: postgresql://user:password@localhost:5432/lyp_db
# Ejemplo Supabase: postgresql://postgres:[PASSWORD]@db.supabase.co:5432/postgres
DATABASE_URL="postgresql://user:password@localhost:5432/lyp_db"

# Autenticación (JWT)
JWT_SECRET="secret_key_super_segura_cambiar_en_produccion"

# Entorno
NODE_ENV="development"
