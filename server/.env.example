# Configuración del Puerto
PORT=3001

# Base de datos SQLite, según prisma/schema.prisma.
# La ruta es relativa al esquema de Prisma. No subir la base a GitHub.
DATABASE_URL="file:./dev.db"

# Archivos privados del expediente. Por defecto: server/storage/case-files.
# En hosting, usar un volumen persistente fuera de cualquier carpeta pública.
# CASE_FILES_DIR="C:/ruta/privada/case-files"

# JWT Secret — REQUERIDO en producción. Nunca usar el valor de ejemplo.
# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="REPLACE_WITH_GENERATED_SECRET"

# Entorno
NODE_ENV="development"

# OpenAI API Key (para búsqueda de jurisprudencia)
# Configurar en el servidor — nunca en el cliente.
OPENAI_API_KEY="REPLACE_WITH_YOUR_OPENAI_KEY"

# URL del frontend (para CORS en producción)
FRONTEND_URL="https://your-app-domain.com"
